{
  "name": "social-video-workbench",
  "version": "1.4.1",
  "private": true,
  "description": "可通过 Docker 部署的视频下载、分析与抖音发布工作台",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "vite build --config vite.config.ts && vite build --config vite.server.config.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:cloudflare": "tsc --noEmit -p cloudflare/tsconfig.json",
    "smoke:deployments": "npm run build && node scripts/smoke-deployments.mjs",
    "cloudflare:resources": "node cloudflare/create-resources.mjs",
    "cloudflare:dev": "wrangler d1 migrations apply svw-workbench --local --config cloudflare/wrangler.jsonc && npm run build && wrangler dev --config cloudflare/wrangler.jsonc",
    "cloudflare:ssh": "sh cloudflare/ssh.sh",
    "cloudflare:publish": "sh cloudflare/publish.sh",
    "cloudflare:deploy": "sh cloudflare/deploy.sh"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@node-rs/argon2": "^2.2.1",
    "http-proxy": "^1.18.1",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.148.0"
  }
}
