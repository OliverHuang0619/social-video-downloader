{
  "name": "social-video-workbench",
  "version": "1.1.0",
  "private": true,
  "description": "可通过 Docker 部署的视频下载、分析与抖音发布工作台",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "vite build --config vite.config.ts && vite build --config vite.server.config.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "http-proxy": "^1.18.1",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
