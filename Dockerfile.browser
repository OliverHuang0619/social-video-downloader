FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:99
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get install -y --no-install-recommends chromium xvfb openbox x11vnc novnc websockify curl ca-certificates fonts-noto-cjk tini gosu \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 browser \
    && mkdir -p /browser-profile /downloads /imports \
    && chown -R browser:browser /browser-profile /home/browser
COPY browser-entrypoint.sh /usr/local/bin/browser-entrypoint.sh
RUN chmod 0755 /usr/local/bin/browser-entrypoint.sh
EXPOSE 6080 9222
VOLUME ["/browser-profile"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/browser-entrypoint.sh"]
